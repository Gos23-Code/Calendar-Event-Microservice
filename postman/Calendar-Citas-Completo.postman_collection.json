            "body": {
              "mode": "raw",
              "raw": "{\n  \"serviceId\": \"{{servicePosop}}\",\n  \"petId\": \"{{petToby}}\",\n  \"startsAt\": \"{{startsAt}}\",\n  \"notes\": \"Se lame la herida por las noches\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/veterinaries/{{veterinaryId}}/appointment-requests",
              "host": ["{{baseUrl}}"],
              "path": ["veterinaries", "{{veterinaryId}}", "appointment-requests"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test('REQUESTED (la clínica de demo exige confirmación)', () => pm.expect(b.status).to.eql('REQUESTED'));",
