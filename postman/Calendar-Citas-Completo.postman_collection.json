    {
      "name": "2. Citas - clínica (requiere datos en Veterinary)",
      "description": "Necesita: la clínica veterinaryId existente en Veterinary, el empleado con APPOINTMENT_MANAGE y la mascota petToby compartida con esa clínica. Sin eso, access responde 404 o ACCESS_DENIED.",
      "item": [
        {
          "name": "2.1 Crear cita confirmada (201 CONFIRMED)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{clinicToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"serviceId\": \"{{servicePosop}}\",\n  \"petId\": \"{{petToby}}\",\n  \"employeeId\": \"{{luisId}}\",\n  \"startsAt\": \"{{clinicStartsAt}}\",\n  \"notes\": \"Vacuna anual\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/veterinaries/{{veterinaryId}}/appointments",
              "host": ["{{baseUrl}}"],
              "path": ["veterinaries", "{{veterinaryId}}", "appointments"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('CONFIRMED y origen CLINIC', () => { const b = pm.response.json(); pm.expect(b.status).to.eql('CONFIRMED'); pm.expect(b.origin).to.eql('CLINIC'); });"
                ]
