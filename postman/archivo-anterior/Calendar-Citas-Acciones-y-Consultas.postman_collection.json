{
  "info": {
    "_postman_id": "d3f4a5b6-c7d8-4e9f-8a0b-1c2d3e4f5a6b",
    "name": "Calendar - Citas: acciones y consultas",
    "description": "Acciones sobre una cita y consultas de agenda. Usar con el environment 'Calendar - Citas Local' (tokens por el login del environment).\n\nORDEN:\n4. Dueño: se puede probar hoy en local (solo Supabase y token del dueño). Corre 4.1 primero: guarda una cita del dueño para las demás.\n3. Clínica: necesita Veterinary (permisos y mascota compartida) y en .env.local SIM_CLINIC_USER_ID con el sub del empleado (el de clinicBaseToken). Sin eso, la agenda responde 403.\n\nLIMPIEZA: las acciones cambian el estado de las citas. Para repetir, crea citas nuevas con la carpeta 1 de la colección de Fase 2.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "veterinaryId", "value": "11111111-1111-4111-8111-111111111111" },
    { "key": "fromDate", "value": "2026-12-07T05:00:00.000Z" },
    { "key": "toDate", "value": "2026-12-08T05:00:00.000Z" },
    { "key": "apptId", "value": "", "description": "Cita para las acciones de la clínica. Lo llena 3.1." },
    { "key": "ownerApptId", "value": "", "description": "Cita del dueño para cancelar y reprogramar. Lo llena 4.1." }
  ],
  "item": [
    {
      "name": "3. Clínica (requiere Veterinary y SIM_CLINIC_USER_ID)",
      "item": [
        {
          "name": "3.1 Agenda del día (GET, guarda una cita)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{clinicToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/veterinaries/{{veterinaryId}}/appointments?from={{fromDate}}&to={{toDate}}",
              "host": ["{{baseUrl}}"],
              "path": ["veterinaries", "{{veterinaryId}}", "appointments"],
              "query": [
                { "key": "from", "value": "{{fromDate}}" },
                { "key": "to", "value": "{{toDate}}" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const list = pm.response.json().appointments;",
                  "pm.test('Devuelve un arreglo', () => pm.expect(list).to.be.an('array'));",
                  "const pending = list.find(a => a.status === 'REQUESTED' || a.status === 'CONFIRMED');",
                  "if (pending) { pm.collectionVariables.set('apptId', pending.id); }",
                  "pm.test('Hay una cita para probar acciones', () => pm.expect(pending, 'agenda vacía').to.exist);"
                ]
              }
            }
          ]
        },
        {
          "name": "3.2 Confirmar (PATCH confirm)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{clinicToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/veterinaries/{{veterinaryId}}/appointments/{{apptId}}/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["veterinaries", "{{veterinaryId}}", "appointments", "{{apptId}}", "confirm"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('CONFIRMED', () => pm.expect(pm.response.json().status).to.eql('CONFIRMED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "3.3 Rechazar sin motivo (400 VALIDATION_ERROR)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{clinicToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{}" },
            "url": {
              "raw": "{{baseUrl}}/veterinaries/{{veterinaryId}}/appointments/{{apptId}}/reject",
              "host": ["{{baseUrl}}"],
              "path": ["veterinaries", "{{veterinaryId}}", "appointments", "{{apptId}}", "reject"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));",
                  "pm.test('VALIDATION_ERROR', () => pm.expect(pm.response.json().code).to.eql('VALIDATION_ERROR'));"
                ]
              }
            }
          ]
        },
        {
          "name": "3.4 Check-in (PATCH check-in)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{clinicToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/veterinaries/{{veterinaryId}}/appointments/{{apptId}}/check-in",
              "host": ["{{baseUrl}}"],
              "path": ["veterinaries", "{{veterinaryId}}", "appointments", "{{apptId}}", "check-in"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 o 409 si la cita no estaba confirmada', () => pm.expect([200, 409]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "3.5 Acción desconocida (404 ACTION_NOT_FOUND)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{clinicToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/veterinaries/{{veterinaryId}}/appointments/{{apptId}}/volar",
              "host": ["{{baseUrl}}"],
              "path": ["veterinaries", "{{veterinaryId}}", "appointments", "{{apptId}}", "volar"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404', () => pm.response.to.have.status(404));",
                  "pm.test('ACTION_NOT_FOUND', () => pm.expect(pm.response.json().code).to.eql('ACTION_NOT_FOUND'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Dueño (se puede probar en local)",
      "item": [
        {
          "name": "4.1 Mis citas (GET /me/appointments, guarda una cita propia)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{ownerToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/me/appointments?from={{fromDate}}&to={{toDate}}",
              "host": ["{{baseUrl}}"],
              "path": ["me", "appointments"],
              "query": [
                { "key": "from", "value": "{{fromDate}}" },
                { "key": "to", "value": "{{toDate}}" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const list = pm.response.json().appointments;",
                  "pm.test('Cada cita trae el nombre de la clínica', () => list.forEach(a => pm.expect(a.clinicName).to.eql('Clínica Patitas')));",
                  "const mine = list.find(a => a.status === 'REQUESTED' || a.status === 'CONFIRMED');",
                  "if (mine) { pm.collectionVariables.set('ownerApptId', mine.id); }",
                  "pm.test('Hay una cita propia para probar', () => pm.expect(mine, 'no hay citas activas del dueño').to.exist);"
                ]
              }
            }
          ]
        },
        {
          "name": "4.2 Reprogramar a 11:00 Bogotá (PATCH reschedule)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"startsAt\": \"2026-12-07T16:00:00.000Z\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/veterinaries/{{veterinaryId}}/appointments/{{ownerApptId}}/reschedule",
              "host": ["{{baseUrl}}"],
              "path": ["veterinaries", "{{veterinaryId}}", "appointments", "{{ownerApptId}}", "reschedule"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 o 409 si la franja está ocupada', () => pm.expect([200, 409]).to.include(pm.response.code));",
                  "if (pm.response.code === 200) { pm.test('Nueva hora de inicio', () => pm.expect(pm.response.json().startsAt).to.eql('2026-12-07T16:00:00.000Z')); }"
                ]
              }
            }
          ]
        },
        {
          "name": "4.3 Cancelar con motivo (PATCH cancel)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Ya no puedo llevarlo\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/veterinaries/{{veterinaryId}}/appointments/{{ownerApptId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["veterinaries", "{{veterinaryId}}", "appointments", "{{ownerApptId}}", "cancel"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 o 409 si ya venció el plazo de 24 h', () => pm.expect([200, 409]).to.include(pm.response.code));",
                  "if (pm.response.code === 200) { pm.test('CANCELLED por el dueño', () => { const b = pm.response.json(); pm.expect(b.status).to.eql('CANCELLED'); pm.expect(b.cancelledBy).to.eql('OWNER'); }); }"
                ]
              }
            }
          ]
        },
        {
          "name": "4.4 No asistió con token de dueño (403 CLINIC_TOKEN_REQUIRED)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{ownerToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/veterinaries/{{veterinaryId}}/appointments/{{ownerApptId}}/no-show",
              "host": ["{{baseUrl}}"],
              "path": ["veterinaries", "{{veterinaryId}}", "appointments", "{{ownerApptId}}", "no-show"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403', () => pm.response.to.have.status(403));",
                  "pm.test('CLINIC_TOKEN_REQUIRED', () => pm.expect(pm.response.json().code).to.eql('CLINIC_TOKEN_REQUIRED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "4.5 Agenda con token de dueño (403 CLINIC_TOKEN_REQUIRED)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{ownerToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/veterinaries/{{veterinaryId}}/appointments?from={{fromDate}}&to={{toDate}}",
              "host": ["{{baseUrl}}"],
              "path": ["veterinaries", "{{veterinaryId}}", "appointments"],
              "query": [
                { "key": "from", "value": "{{fromDate}}" },
                { "key": "to", "value": "{{toDate}}" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403', () => pm.response.to.have.status(403));",
                  "pm.test('CLINIC_TOKEN_REQUIRED', () => pm.expect(pm.response.json().code).to.eql('CLINIC_TOKEN_REQUIRED'));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
