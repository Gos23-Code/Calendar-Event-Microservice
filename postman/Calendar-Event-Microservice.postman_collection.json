                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/calendar-events?userId={{userId}}&calendarType=pet",
              "host": ["{{baseUrl}}"],
              "path": ["calendar-events"],
              "query": [
                { "key": "userId", "value": "{{userId}}" },
                { "key": "calendarType", "value": "pet" }
              ]
            }
          }
        },
        {
          "name": "Listar eventos por mascota (petId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
