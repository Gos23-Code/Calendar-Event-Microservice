                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/calendar-events?petId={{petId}}",
              "host": ["{{baseUrl}}"],
              "path": ["calendar-events"],
              "query": [{ "key": "petId", "value": "{{petId}}" }]
