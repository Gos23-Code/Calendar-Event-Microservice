# Copiar a .env.local y completar. NO subir .env.local al repo.

# Supabase: URL BASE del proyecto, sin /rest/v1/ (supabase-js la agrega).
NEXT_PUBLIC_SUPABASE_URL=https://<tu-proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
# Decisión 3 pendiente: clave service_role SOLO en el servidor (sin prefijo NEXT_PUBLIC_).
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Google Cloud Pub/Sub
GOOGLE_CLOUD_PROJECT=<project-id>
PUBSUB_CALENDAR_TOPIC=calendar-event
ENABLE_INTERNAL_REMINDER_CRON=true

# Autenticación de usuarios (JWT RS256, CONTRATOS_COMPARTIDOS.md sección 1)
JWT_JWKS_URL=https://<user-service>/.well-known/jwks.json
JWT_ISSUER=myanimalog-user-service
JWT_AUDIENCE=myanimalog-api

# Servicio a servicio (CONTRATOS_COMPARTIDOS.md sección 2). Obligatoria: el servidor no arranca sin ella.
INTERNAL_API_KEY=<clave-compartida-entre-servicios>
VETERINARY_SERVICE_URL=https://<veterinary-service>

# Eventos de cita (Fase 4). Apagados por defecto: en local no se publica nada.
EVENTS_ENABLED=false
VET_APPOINTMENTS_TOPIC=veterinary-appointments

# Demo local (opcionales): apuntan los datos simulados a usuarios y clínica reales de tus pruebas.
# SIM_VET_ID=<id-de-la-clinica-de-prueba>
# SIM_OWNER_USER_ID=<sub-del-dueño-de-prueba>
# SIM_CLINIC_USER_ID=<sub-del-empleado-de-clinica-de-prueba>  (para la agenda)
